{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "maxLength": 800,
      "minLength": 20,
      "type": "string"
    },
    "factoryLubed": {
      "type": "boolean"
    },
    "housingBottom": {
      "enum": [
        "pc",
        "pom",
        "nylon",
        "pa66",
        "lcp",
        "mixed",
        "unknown"
      ],
      "type": "string"
    },
    "housingTop": {
      "enum": [
        "pc",
        "pom",
        "nylon",
        "pa66",
        "lcp",
        "mixed",
        "unknown"
      ],
      "type": "string"
    },
    "name": {
      "minLength": 2,
      "type": "string"
    },
    "releasedAt": {
      "anyOf": [
        {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "slug": {
      "minLength": 2,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "springGrams": {
      "additionalProperties": false,
      "properties": {
        "actuation": {
          "exclusiveMinimum": 0,
          "maximum": 200,
          "type": "number"
        },
        "bottomOut": {
          "exclusiveMinimum": 0,
          "maximum": 200,
          "type": "number"
        }
      },
      "required": [
        "actuation",
        "bottomOut"
      ],
      "type": "object"
    },
    "status": {
      "enum": [
        "in-production",
        "discontinued",
        "limited"
      ],
      "type": "string"
    },
    "stem": {
      "enum": [
        "pom",
        "pc",
        "lcp",
        "mixed",
        "unknown"
      ],
      "type": "string"
    },
    "travelMm": {
      "exclusiveMinimum": 0,
      "maximum": 10,
      "type": "number"
    },
    "type": {
      "enum": [
        "linear",
        "tactile",
        "clicky",
        "silent-linear",
        "silent-tactile"
      ],
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "vendorSlug": {
      "minLength": 2,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    }
  },
  "required": [
    "slug",
    "name",
    "vendorSlug",
    "type",
    "housingTop",
    "housingBottom",
    "stem",
    "springGrams",
    "travelMm",
    "factoryLubed",
    "releasedAt",
    "status",
    "description",
    "updatedAt"
  ],
  "title": "switch",
  "type": "object"
}
