{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "caseMaterial": {
      "enum": [
        "aluminum",
        "polycarbonate",
        "wood",
        "fr4",
        "plastic",
        "mixed"
      ],
      "type": "string"
    },
    "description": {
      "maxLength": 800,
      "minLength": 20,
      "type": "string"
    },
    "hotswap": {
      "type": "boolean"
    },
    "layout": {
      "enum": [
        "60",
        "65",
        "75",
        "tkl",
        "full",
        "alice",
        "split",
        "ortho",
        "other"
      ],
      "type": "string"
    },
    "mountStyle": {
      "enum": [
        "gasket",
        "top-mount",
        "tray-mount",
        "integrated-plate",
        "leaf-spring",
        "pcb-mount"
      ],
      "type": "string"
    },
    "name": {
      "minLength": 2,
      "type": "string"
    },
    "releasedAt": {
      "anyOf": [
        {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "slug": {
      "minLength": 2,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "status": {
      "enum": [
        "in-stock",
        "group-buy",
        "discontinued"
      ],
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "vendorSlug": {
      "minLength": 2,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "wireless": {
      "type": "boolean"
    }
  },
  "required": [
    "slug",
    "name",
    "vendorSlug",
    "layout",
    "caseMaterial",
    "mountStyle",
    "hotswap",
    "wireless",
    "releasedAt",
    "status",
    "description",
    "updatedAt"
  ],
  "title": "board",
  "type": "object"
}
