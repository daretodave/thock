{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "maxLength": 800,
      "minLength": 20,
      "type": "string"
    },
    "designer": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "legendType": {
      "enum": [
        "doubleshot",
        "dye-sub",
        "pad-printed",
        "engraved",
        "blank"
      ],
      "type": "string"
    },
    "material": {
      "enum": [
        "abs",
        "pbt",
        "resin",
        "mixed"
      ],
      "type": "string"
    },
    "name": {
      "minLength": 2,
      "type": "string"
    },
    "profile": {
      "enum": [
        "cherry",
        "oem",
        "mt3",
        "sa",
        "kat",
        "kam",
        "xda",
        "dsa"
      ],
      "type": "string"
    },
    "releasedAt": {
      "anyOf": [
        {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "slug": {
      "minLength": 2,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "status": {
      "enum": [
        "in-stock",
        "sold-out",
        "group-buy",
        "discontinued"
      ],
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "vendorSlug": {
      "minLength": 2,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    }
  },
  "required": [
    "slug",
    "name",
    "vendorSlug",
    "profile",
    "material",
    "legendType",
    "designer",
    "releasedAt",
    "status",
    "description",
    "updatedAt"
  ],
  "title": "keycap-set",
  "type": "object"
}
