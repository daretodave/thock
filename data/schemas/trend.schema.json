{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "isoWeek": {
      "pattern": "^\\d{4}-W(0[1-9]|[1-4]\\d|5[0-3])$",
      "type": "string"
    },
    "publishedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "rows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "articleSlug": {
            "anyOf": [
              {
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "category": {
            "enum": [
              "switch",
              "keycap",
              "layout",
              "vendor",
              "brand"
            ],
            "type": "string"
          },
          "direction": {
            "enum": [
              "up",
              "down",
              "flat"
            ],
            "type": "string"
          },
          "name": {
            "maxLength": 80,
            "minLength": 2,
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 280,
                "minLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "score": {
            "maximum": 100,
            "minimum": -100,
            "type": "number"
          },
          "spark": {
            "items": {
              "type": "number"
            },
            "maxItems": 16,
            "minItems": 2,
            "type": "array"
          }
        },
        "required": [
          "name",
          "category",
          "direction",
          "score",
          "spark",
          "articleSlug"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "updatedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    }
  },
  "required": [
    "isoWeek",
    "publishedAt",
    "rows",
    "updatedAt"
  ],
  "title": "trend",
  "type": "object"
}
