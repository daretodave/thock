{
  "name": "@thock/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build:manifest": "tsx scripts/generate-data-manifest.mts",
    "build:search": "tsx scripts/generate-search-index.mts",
    "build:viz-manifest": "tsx scripts/generate-viz-manifest.mts",
    "prebuild": "pnpm build:manifest && pnpm build:search && pnpm build:viz-manifest",
    "build": "next build",
    "start": "next start",
    "start:e2e": "next start -p 4173",
    "typecheck": "tsc --noEmit",
    "pretest:run": "pnpm build:manifest && pnpm build:search",
    "test": "vitest",
    "test:run": "vitest run",
    "size": "tsx scripts/measure-bundle.mts",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@thock/content": "workspace:*",
    "@thock/data": "workspace:*",
    "@thock/seo": "workspace:*",
    "@thock/tokens": "workspace:*",
    "@thock/ui": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "minisearch": "^7.2.0",
    "next": "^16.3.5",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@thock/tsconfig": "workspace:*",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
